{
    "seed": 0,
    "name": "vanilla-1",
    "outdir": "./outputs",
    "dataset": {
        "topology": {
            "kind": "FS",
            "parameters": {
                "path": "data/ieee39.txt",
                "format": "edgelist"
            }
        }
    },
    "model": {
        "kind": "vanilla_transformer",
        "parameters": {
            "c_in": 4,
            "c_out": 1,
            "n_heads": 16,
            "d_head": 8,
            "d_model": 4,
            "d_ff": 96,
            "n_enc_layers": 1,
            "n_dec_layers": 1,
            "activation": "gelu",
            "dropout": 0.1
        }
    },
    "tasks": [
        {
            "kind": "training",
            "parameters": {
                "seed": 0,
                "train_val_test_splits": [
                    0.7,
                    0.1,
                    0.2
                ],
                "batch_size": 7,
                "num_epochs": 100,
                "loss_function": "mse",
                "optimizer": {
                    "kind": "adamw",
                    "parameters": {
                        "lr": 1e-3
                    }
                },
                "device": "cpu",
                "dtype": "float32",
                "debug": {
                    "activations": false,
                    "gradients": false,
                    "weights_biases": false,
                    "update_parameter_ratio": false
                },
                "output_column": "output",
                "output": {
                    "data": true,
                    "plots": true,
                    "metrics": true
                },
                "resume_training": false
            }
        }
    ]
}